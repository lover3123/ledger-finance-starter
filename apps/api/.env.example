# ── Ledger API ────────────────────────────────────────────────────────────────

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ledger

# JWT secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET=local-development-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me

# Server port
PORT=4000

# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Base URL for the app (used in email links, QR data, etc.)
APP_BASE_URL=http://localhost:5173

# File upload directory
UPLOAD_STORAGE=./uploads

# Payment provider: "sandbox" | "production"
PAYMENT_PROVIDER=sandbox

# ── Feature Flags ─────────────────────────────────────────────────────────────

# Enable UPI intent deep-link generation
ENABLE_UPI_INTENT=true

# Enable sandbox payment simulation (development only)
ENABLE_SANDBOX_PROVIDER=true

# Enable evidence file uploads
ENABLE_EVIDENCE_UPLOAD=true

# Enable group expense splitting (2+ people)
ENABLE_GROUP_SPLIT=true

# Enable relationship budget limits
ENABLE_RELATIONSHIP_BUDGET=true
